{
  "name": "albrus-firma",
  "version": "1.0.0",
  "description": "Albrus Company Firma Yönetim Programı",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "make": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "playwright-core": "^1.60.0"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  },
  "build": {
    "appId": "com.albrus.firma",
    "productName": "Albrus Firma",
    "files": [
      "main.js",
      "launch.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
